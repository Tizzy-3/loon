#!name=WPS 每日签到
#!desc=每天 10:00 自动签到；Cookie 获取由 BoxJS 开关控制，默认关闭。需 Loon 并安装、信任 MITM 证书。Loon 没有 Surge 的 Panel 面板，手动跑一次请在 Loon「脚本」页找到 tag=WPS_SignIn 的定时任务点「运行」。
# 转换说明：原 [Panel] 与 type=generic(wps.panel.js, engine=webview) 手动面板项 Loon 不支持，已删除；cookie 捕获里的 requires-body=false / max-size=0 为 Surge 默认值，Loon 侧省略即为默认不取 body。

[Script]
http-request ^https://personal-act\.wps\.cn/activity-rubik/activity/page_info script-path=https://raw.githubusercontent.com/Tizzy-3/Surge/main/wps/wps.cookie.capture.js?v=boxjs-capture-1, timeout=10, tag=WPS_Cookie, enable=true
cron "0 10 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.js, timeout=120, tag=WPS_SignIn, enable=true

[MitM]
hostname = %APPEND% personal-act.wps.cn
