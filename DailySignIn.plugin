#!name=Tizzy3 每日签到
#!desc=哈士奇 / IMYAI / 金蝶云社区每日签到。凭证捕获由 BoxJS 开关控制，默认关闭。需 Loon 并安装、信任 MITM 证书（Loon 证书与 Surge 不通用）。每天设备本地时间 07:00 自动签到；Loon 没有 Surge 的 Panel 面板，想手动跑一次请在 Loon「脚本」页找到 tag=Tizzy3_DailySignIn 的定时任务点「运行」。
# 转换说明：原 Surge 模块的 [Panel] 与 type=generic(engine=webview) 手动面板项 Loon 不支持，已删除；其余脚本参数等价迁移，engine=jsc 为 Surge 专属已去掉。

[Script]
cron "0 7 * * *" script-path=https://raw.githubusercontent.com/Tizzy-3/Surge/main/daily-signin/surge_signin.js?v=manual-panel-1, timeout=300, tag=Tizzy3_DailySignIn, enable=true
http-response ^https://www\.haxiaohaios2\.com/ script-path=https://raw.githubusercontent.com/Tizzy-3/Surge/main/daily-signin/surge_cookie_capture.js?v=boxjs-capture-1, timeout=10, tag=Tizzy3_Hashiqi_Cookie, enable=true
http-response ^https://super\.imyaigc\.com/ script-path=https://raw.githubusercontent.com/Tizzy-3/Surge/main/daily-signin/surge_cookie_capture.js?v=boxjs-capture-1, timeout=10, tag=Tizzy3_IMYAI_Web_Cookie, enable=true
http-request ^https://api\.(daka\.today|imyaigc\.com)/api/ script-path=https://raw.githubusercontent.com/Tizzy-3/Surge/main/daily-signin/surge_cookie_capture.js?v=boxjs-capture-1, timeout=10, tag=Tizzy3_IMYAI_Request_Cookie, enable=true
http-response ^https://api\.(daka\.today|imyaigc\.com)/api/ script-path=https://raw.githubusercontent.com/Tizzy-3/Surge/main/daily-signin/surge_cookie_capture.js?v=boxjs-capture-1, requires-body=true, max-size=2097152, timeout=10, tag=Tizzy3_IMYAI_Response_Cookie, enable=true
http-response ^https://vip\.kingdee\.com/ script-path=https://raw.githubusercontent.com/Tizzy-3/Surge/main/daily-signin/surge_cookie_capture.js?v=boxjs-capture-1, timeout=10, tag=Tizzy3_Kingdee_Cookie, enable=true

[MitM]
hostname = %APPEND% www.haxiaohaios2.com, super.imyaigc.com, api.daka.today, api.imyaigc.com, vip.kingdee.com
